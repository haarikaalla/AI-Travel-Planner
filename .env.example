# ═══════════════════════════════════════════════════════════════
#  AI Travel Planner — configuration
#  Copy to .env:   cp .env.example .env   (Windows: copy .env.example .env)
#  Nothing here is required. With zero keys the app runs fully local
#  on Ollama and still pulls live geo/climate/currency data.
# ═══════════════════════════════════════════════════════════════

# ── Which brain to use ─────────────────────────────────────────
# ollama | groq | google | openai | anthropic | openrouter
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2

# Comma-separated providers to try when the primary one fails.
LLM_FALLBACK_PROVIDERS=ollama

# ── Ollama — local, free, no key ───────────────────────────────
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# ── Groq — free tier, fastest inference ────────────────────────
# https://console.groq.com/keys
# GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Gemini — generous free tier ─────────────────────────
# https://aistudio.google.com/apikey
# GOOGLE_API_KEY=...
GOOGLE_MODEL=gemini-2.0-flash

# ── OpenAI ─────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Anthropic ──────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── OpenRouter — one key, hundreds of models ───────────────────
# OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ── Live grounding (all keyless, all free) ─────────────────────
ENABLE_LIVE_DATA=true
LIVE_DATA_TIMEOUT_SECONDS=8

# ── Performance ────────────────────────────────────────────────
ENABLE_LLM_CACHE=true
CACHE_PATH=.cache/llm_cache.sqlite

# ── Observability (optional) ───────────────────────────────────
# https://smith.langchain.com
# LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ai-travel-planner
